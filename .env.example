# Copy to .env. Do not commit .env.
# Leave the Auth0 values empty while debugging. The app opens on the session list,
# and the sign-in page stays at /login until these are set.

# Auth0 Single Page Application. The client id is public. Do not put a client secret here.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=

# Comma-separated emails. Anyone else who can sign in at Auth0 is still refused by the API.
ALLOWED_EMAILS=

# Same CouchDB the field app syncs with. These stay on the server.
COUCHDB_URL=http://127.0.0.1:5984
COUCHDB_USER=
COUCHDB_PASSWORD=

